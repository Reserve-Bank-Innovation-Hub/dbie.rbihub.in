# Dependencies
node_modules/
yarn.lock

# Build outputs
.next/
dist/
build/
out/

# Site data bundle, downloaded from S3 at build time (pnpm data:pull); not committed
public/data/

# Environment - only ignore .local and .production files
.env
.env.common
.env.local
.env.*.local
.env.production

# Allow committing .development files
!.env.development

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# OS
.DS_Store
Thumbs.db
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo

# Vercel
.vercel

# Scraped data is not versioned in git: the database is the system of record and every scrape is archived to S3
# (pnpm data:archive; restore with pnpm data:fetch). See docs/database.md.
data/sdmx/
data/reports/
data/sdmx-raw/
data/bse-raw/
# Scraper recon artefacts
scripts/recon/output/

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate*
infra/terraform/**/*.tfplan

# Which archived scrape data/ holds (written by pnpm data:archive / data:fetch)
data/.scrape-version
