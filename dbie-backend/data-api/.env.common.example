# Local config for dbie-data-api against the common-projects database. Copy to .env.common (gitignored).
# Pointers only: the reader role's credentials come from Secrets Manager; the database is reached over the RBIH tailnet.
AWS_PROFILE=common-projects
AWS_REGION=ap-south-1
ENVIRONMENT=development
PORT=8000

# Read-only role; the loaders use dbie/db-common (repo-root .env.common), this service never needs it.
DB_SECRET_NAME=dbie/db-common-reader

# Comma-separated; empty means any origin may read (the data is public).
ALLOWED_ORIGINS=

# Optional: MAX_ROWS (5000), REGISTRY_REFRESH_MINUTES (10), CACHE_SECONDS (300), LOG_LEVEL (info)
