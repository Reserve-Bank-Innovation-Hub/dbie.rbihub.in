# Local config for the DBIE data tooling (scrape, load, archive, release), targeting the common-projects account.
# Copy to .env.common (gitignored). Pointers only, never secrets: credentials come from AWS Secrets Manager, and the
# database is reached directly over the RBIH tailnet (Tailscale). Values come from `terraform output` in
# infra/terraform/common.

AWS_PROFILE=common-projects
AWS_REGION=ap-south-1
ENVIRONMENT=common

# Database — private RDS in the common-projects account; host, port, dbname, username and password come from the secret.
DB_SECRET_NAME=dbie/db-common

# Buckets — scrape archives (pnpm data:archive / data:fetch) and site data releases (pnpm data:release / data:pull).
SCRAPES_BUCKET=dbie-common-scrapes
SITE_DATA_BUCKET=dbie-common-site-data

# SSM fallback without the tailnet (scripts/db-tunnel.sh); the bastion's instance id from `terraform output`.
BASTION_INSTANCE_ID=

# Optional: an Amplify incoming webhook; `pnpm data:release` calls it so the site rebuilds on the new release.
AMPLIFY_WEBHOOK_URL=
